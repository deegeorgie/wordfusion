generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Role enum as constant strings ──────────────────────────────────────
// USER     = Simple player (can browse & play puzzles)
// CREATOR  = Can create/manage own puzzles + generate with AI
// ADMIN    = Full control: publish/unpublish, categories, packs, schedule

model User {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  password         String?  // bcrypt hash (null for OAuth users)
  role             String   @default("USER") // "USER" | "CREATOR" | "ADMIN"
  provider         String?  // "credentials" | "google" | "github"
  providerAccountId String?  // unique ID from the OAuth provider
  // Demographic fields (all optional — collected at registration)
  phone            String?
  dateOfBirth      String?  // YYYY-MM-DD
  gender           String?  // "male" | "female" | "other" | "prefer_not_to_say"
  country          String?
  city             String?
  occupation       String?
  education        String?  // "none" | "primary" | "secondary" | "bachelor" | "master" | "doctorate" | "other"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  puzzles          CrosswordPuzzle[]
}

model Pack {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String   @default("📦")
  language    String   @default("fr") // "fr" or "en"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  puzzles     CrosswordPuzzle[]
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  icon      String   @default("🏷️")
  language  String   @default("fr") // "fr" or "en"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  puzzles   CrosswordPuzzle[]
}

model CrosswordPuzzle {
  id               String    @id @default(cuid())
  puzzleNumber     Int       @unique              // Auto-incremented unique number (#001, #002, …)
  title            String                         // Display title (auto-set from puzzleNumber)
  description      String?
  difficulty       Int       @default(1)          // 1=Easy, 2=Medium, 3=Hard
  language         String    @default("fr")       // "fr" or "en"
  categoryId       String?
  category         Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  packId           String?
  pack             Pack?     @relation(fields: [packId], references: [id], onDelete: SetNull)
  creatorId        String?
  creator          User?     @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  gridData         String                         // JSON string of the grid layout
  wordsData        String                         // JSON string of word placements
  cluesData        String                         // JSON string of clues
  rows             Int
  cols             Int
  publishDate      DateTime?                      // Scheduled publication date
  firstPublishedAt DateTime?                      // Immutable: set once when first published
  published        Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([publishDate])
  @@index([firstPublishedAt])
  @@index([published])
}

model UserProgress {
  id          String   @id @default(cuid())
  puzzleId    String
  userId      String   @default("anonymous")
  completed   Boolean  @default(false)
  timeSpent   Int      @default(0) // seconds
  hintsUsed   Int      @default(0)
  progress    String   @default("{}") // JSON string of filled letters
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([puzzleId, userId])
}

model PublishingSchedule {
  id           String   @id @default(cuid())
  puzzlesPerDay Int      @default(1)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
